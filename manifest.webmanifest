{"name":"GPX Terrain","short_name":"GPX Terrain","description":"See a GPX track on real 3D terrain: elevation profile, playback, waypoints. An installable web app built with three-map-terrain.","start_url":"./","display":"standalone","background_color":"#0a0a0a","theme_color":"#0a0a0a","lang":"en","scope":"./","id":"./","dir":"ltr","orientation":"any","categories":["navigation","sports","travel"],"icons":[{"src":"icons/icon-192.png","sizes":"192x192","type":"image/png","purpose":"any"},{"src":"icons/icon-512.png","sizes":"512x512","type":"image/png","purpose":"any"},{"src":"icons/maskable-512.png","sizes":"512x512","type":"image/png","purpose":"maskable"}],"file_handlers":[{"action":"./","accept":{"application/gpx+xml":[".gpx"]}}],"launch_handler":{"client_mode":["focus-existing","auto"]}}
